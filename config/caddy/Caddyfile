# User-facing proxy. Everything client-specific comes from environment
# variables set in .env (CLIENT_SLUG, PUBLIC_HOST, ADMIN_BASIC_*).
# TLS: certificates generated by install.sh in ./certs (own CA). Replace
# certs/server.crt + server.key with your corporate/ACME certificate if wanted.
{
	auto_https off
	admin localhost:2019
}

(tls_local) {
	tls /certs/server.crt /certs/server.key
}

(client_header) {
	header {
		X-Client {$CLIENT_SLUG}
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}
}

# Apps without their own login (Prometheus, Alertmanager, Oxidized) sit behind
# a basic-auth gate. Hash = bcrypt, created by install.sh.
(admin_auth) {
	basic_auth {
		{$ADMIN_BASIC_USER} {$ADMIN_BASIC_HASH}
	}
}

http://:80 {
	redir https://{host}{uri} permanent
}

# Front door: "/" is the first-run setup page until the setup state is
# "complete", then the InsightEngine UI (insightengine-ui, port IE_UI_PORT, default 8080).
# Decision is made per request by asking the
# setup service (forward_auth -> GET /setup/gate): 200 = complete -> continue to
# the UI; anything else (302 to /setup/) is returned to the browser as is.
# /setup/* is always the setup service (token-authenticated API + the static
# first-run page). /api/v1/* is ie-config, after the same gate.
# /healthz is the UI liveness route and is not behind the gate.
# X-Setup-Edge tells the service the request came through here
# (Caddy overwrites any client-supplied value); after completion the service then
# only answers /setup/state and /setup/gate on the edge (unless
# SETUP_PUBLIC_AFTER_COMPLETE=yes).
# If the setup service is down, "/" returns an error (fail closed).
https://{$PUBLIC_HOST} {
	import tls_local
	import client_header
	encode zstd gzip

	@setup path /setup /setup/*
	handle @setup {
		reverse_proxy setup:8099 {
			header_up X-Setup-Edge 1
		}
	}

	# UI liveness. The Next.js route returns {"ok":true} and does not depend on setup.
	@ui_healthz path /healthz
	handle @ui_healthz {
		reverse_proxy insightengine-ui:{$IE_UI_PORT}
	}

	# Settings API. Same setup gate as the UI. /internal/bootstrap-admin is not under /api/v1.
	@settings path /api/v1 /api/v1/*
	handle @settings {
		forward_auth setup:8099 {
			uri /setup/gate
			header_up X-Setup-Edge 1
		}
		reverse_proxy ie-config:8080
	}

	handle {
		forward_auth setup:8099 {
			uri /setup/gate
			header_up X-Setup-Edge 1
		}
		reverse_proxy insightengine-ui:{$IE_UI_PORT}
	}
}

# NetBox (user-facing), moved off "/" to its own port.
https://{$PUBLIC_HOST}:8444 {
	import tls_local
	import client_header
	encode zstd gzip
	reverse_proxy netbox:8080
}

# NetBox API for in-network clients (Prometheus http_sd, Oxidized).
# NOT published to the host. Prometheus verifies this certificate with
# certs/ca.crt and server_name "caddy".
https://caddy:8443 {
	import tls_local
	reverse_proxy netbox:8080
}

https://{$PUBLIC_HOST}:3000 {
	import tls_local
	import client_header
	encode zstd gzip
	reverse_proxy grafana:3000
}

https://{$PUBLIC_HOST}:9090 {
	import tls_local
	import client_header
	import admin_auth
	reverse_proxy prometheus:9090
}

https://{$PUBLIC_HOST}:9093 {
	import tls_local
	import client_header
	import admin_auth
	reverse_proxy alertmanager:9093
}

https://{$PUBLIC_HOST}:8081 {
	import tls_local
	import client_header
	encode zstd gzip
	reverse_proxy activepieces-app:80
}

https://{$PUBLIC_HOST}:5000 {
	import tls_local
	import client_header
	encode zstd gzip
	reverse_proxy netdisco-web:5000
}

https://{$PUBLIC_HOST}:8888 {
	import tls_local
	import client_header
	import admin_auth
	reverse_proxy oxidized:8888
}
