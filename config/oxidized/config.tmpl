---
# Rendered by render.sh at start-up into the oxidized-config volume.
# Placeholders @@LIKE_THIS@@ are replaced from environment / secret files, so
# no credential lives in this repository file.
interval: @@INTERVAL@@
threads: @@THREADS@@
use_syslog: false
debug: false
timeout: 20
retries: 2
prompt: !ruby/regexp /^([\w.@()-]+[#>]\s?)$/
rest: 0.0.0.0:8888
next_adds_job: false
vars: {}
groups: {}
pid: /tmp/oxidized.pid
crash:
  directory: /home/oxidized/.config/oxidized/crashes
  hostnames: false
stats:
  history_size: 10
input:
  default: ssh, telnet
  debug: false
  ssh:
    secure: false          # many network devices use legacy host keys; TODO(Phindani): tighten per device class
output:
  default: git
  git:
    user: oxidized
    email: oxidized@@@CLIENT_SLUG@@.invalid
    repo: /home/oxidized/.config/oxidized/oxidized.git
username: '@@DEVICE_USERNAME@@'
password: '@@DEVICE_PASSWORD@@'
model: ios
# NetBox often has a manufacturer and no platform. Map the manufacturer to the
# command set Oxidized knows. A platform slug that already matches is kept.
model_map:
  !ruby/regexp /(?i)cisco/: ios
  !ruby/regexp /(?i)forti/: fortios
  !ruby/regexp /(?i)palo/: panos
  !ruby/regexp /(?i)juniper/: junos
  ios: ios
  iosxe: ios
  nxos: nxos
  aireos: aireos
  fortios: fortios
  panos: panos
source:
  default: http
  http:
    # Device list straight from NetBox (same CA-verified internal endpoint).
    # The filter is status=active&tag=oxidized: only devices marked for backup.
    # Manufacturer chooses the command set when the platform is empty.
    # ie-config returns the same NetBox devices and adds username and password
    # when Settings → Vault has a login assigned to that device. Other devices
    # keep the username and password above.
    url: http://ie-config:8080/internal/oxidized/nodes
    scheme: http
    secure: false
    hosts_location: results
    map:
      name: name
      model: device_type.manufacturer.name
      ip: primary_ip4.address
      group: site.slug
      username: username
      password: password
    headers:
      Authorization: 'Bearer @@NETBOX_TOKEN@@'
      X-Oxidized-Token: '@@SOURCE_TOKEN@@'
    pagination: true
    pagination_key_name: next
hooks:
  config_changed:
    type: exec
    events: [post_store]
    cmd: '/home/oxidized/.config/oxidized/hooks/notify-change.sh'
    async: true
    timeout: 30
  backup_failed:
    type: exec
    events: [node_fail]
    cmd: '/home/oxidized/.config/oxidized/hooks/notify-change.sh'
    async: true
    timeout: 30
