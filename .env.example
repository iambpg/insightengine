# =============================================================================
# InsightEngine - environment template. Copy to .env or (recommended) let
# ./install.sh create .env for you. NEVER commit a real .env.
#
# Empty values below marked "generated" are filled by install.sh with
# openssl-generated secrets. Sizing values are ESTIMATES for ~20,000 devices per
# client; nothing here was tested on real devices.
# =============================================================================

# ---- client identity (chosen on the first-run page; drives names, labels and titles) ----
CLIENT_NAME='unconfigured'      # set on the first-run page (/setup/); stored in data/setup/config.json; do not edit by hand
CLIENT_SLUG='unconfigured'      # derived from the client name by the setup service
INSTALL_DIR=                    # absolute path of this folder (install.sh sets it)

# ---- host / network ---------------------------------------------------------
PUBLIC_HOST=                      # DNS name or IP users type in the browser (install.sh --public-host or detected)
HOST_BIND=0.0.0.0
MONITORING_SUBNET=10.50.0.0/24
DOCKER_GID=999                    # install.sh detects the group that owns /var/run/docker.sock
COMPOSE_PROFILES=                 # e.g. logs,backup,traps  (scale = more exporters, tools = snmp-generator)

# ---- published host ports (change them while an old stack still runs) -------
PORT_HTTP=80
PORT_HTTPS=443
PORT_GRAFANA=3000
PORT_PROMETHEUS=9090
PORT_ALERTMANAGER=9093
PORT_ACTIVEPIECES=8081
PORT_NETDISCO=5000
PORT_OXIDIZED=8888
PORT_NETBOX=8444                # NetBox UI moved off "/" ("/" is the setup page / custom UI)
PORT_SYSLOG=514
PORT_TRAPS=162

# ---- image versions (TODO(Phindani): confirm every tag; digests are NOT set) -
# Tags below were the current releases when this bundle was prepared; verify them.
PROMETHEUS_IMAGE=prom/prometheus:v3.11.3
# Alertmanager, blackbox and Telegraf tags match the sanitized real stack.
# Grafana stays on the public 13.0.11 tag (the real stack used a one-off build id).
ALERTMANAGER_IMAGE=prom/alertmanager:v0.32.0
SNMP_EXPORTER_IMAGE=prom/snmp-exporter:v0.30.1
SNMP_EXPORTER_VERSION=v0.30.1
BLACKBOX_IMAGE=prom/blackbox-exporter:v0.28.0
CADDY_IMAGE=caddy:2.11.2-alpine
GRAFANA_IMAGE=grafana/grafana:13.0.11
LOKI_IMAGE=grafana/loki:3.7.9
TELEGRAF_IMAGE=telegraf:1.38.3
POSTGRES_IMAGE=postgres:17.9
REDIS_IMAGE=redis:8.6.2
ALPINE_IMAGE=alpine:3.20
# Empty: install.sh builds insightengine/netbox-lists:local from NETBOX_BASE_IMAGE
# plus the lists plugin in netbox/. The real stack used hishaam02/netbox-lists:v4.6-5.0.0
# (private). Set NETBOX_IMAGE to that tag to pull it instead of building.
NETBOX_IMAGE=
NETBOX_BASE_IMAGE=netboxcommunity/netbox:v4.6.3
AP_IMAGE=ghcr.io/activepieces/activepieces:0.92.3-hotfix.1
AP_POSTGRES_IMAGE=postgres:17
NETDISCO_IMAGE_PREFIX=netdisco/netdisco:latest      # TODO(Phindani): pin a release (floating "latest")
OXIDIZED_IMAGE=oxidized/oxidized:latest             # TODO(Phindani): pin a release (floating "latest")

# ---- Prometheus (ESTIMATES for ~20k devices; see README sizing table) -------
PROM_RETENTION_TIME=30d
PROM_RETENTION_SIZE=0             # 0 = no size limit; set e.g. 400GB to cap disk
PROM_MEM=24g
PROM_MEM_RESERVE=8g
PROM_CPUS=8
PROM_QUERY_MAX_SAMPLES=50000000
PROM_QUERY_TIMEOUT=2m
PROM_QUERY_MAX_CONCURRENCY=20

# ---- collectors (ESTIMATES) --------------------------------------------------
SNMP_EXPORTER_MEM=2g
SNMP_EXPORTER_CPUS=2
SNMP_MODULE_CONCURRENCY=4
BLACKBOX_MEM=1g
BLACKBOX_CPUS=2
SCRAPE_LB_MEM=512m
SCRAPE_LB_CPUS=2
TELEGRAF_API_MEM=2g
TELEGRAF_API_CPUS=2
TELEGRAF_HOST_MEM=512m
TELEGRAF_HOST_CPUS=1
TELEGRAF_SYSLOG_MEM=2g
TELEGRAF_SYSLOG_CPUS=2

# ---- SNMP credentials (used by the exporters; never put them in snmp.yml) ---
# Placeholders are valid but unusable; set real ones with install.sh or by hand.
SNMP_V2_COMMUNITY=unset-placeholder
SNMP_V3_USER=unset-placeholder
# snmp.yml uses ${SNMP_V3_USERNAME}. install.sh copies SNMP_V3_USER into this value.
SNMP_V3_USERNAME=unset-placeholder
SNMP_V3_AUTH_PASSWORD=unset-placeholder
SNMP_V3_PRIV_PASSWORD=unset-placeholder

# ---- Alertmanager / Grafana / Caddy -----------------------------------------
ALERTMANAGER_MEM=1g
ALERTMANAGER_CPUS=1
ALERTMANAGER_RETENTION=720h
GRAFANA_MEM=4g
GRAFANA_CPUS=2
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=           # generated
GRAFANA_SECRET_KEY=               # generated
CADDY_MEM=512m
CADDY_CPUS=2
ADMIN_BASIC_USER=admin            # basic-auth in front of Prometheus/Alertmanager/Oxidized
# generated bcrypt hash. KEEP THE SINGLE QUOTES (the hash contains $ characters)
ADMIN_BASIC_HASH=

# ---- NetBox (own PostgreSQL + Redis) ----------------------------------------
NETBOX_DB_NAME=netbox
NETBOX_DB_USER=netbox
NETBOX_DB_PASSWORD=               # generated
NETBOX_REDIS_PASSWORD=            # generated
NETBOX_REDIS_CACHE_PASSWORD=      # generated
NETBOX_SECRET_KEY=                # generated (50+ chars)
NETBOX_API_TOKEN_PEPPER_1=        # generated (50+ chars)
NETBOX_SUPERUSER_NAME=admin
NETBOX_SUPERUSER_EMAIL=
NETBOX_SUPERUSER_PASSWORD=        # generated
NETBOX_SUPERUSER_API_TOKEN=       # generated
NETBOX_MEM=4g
NETBOX_CPUS=4
NETBOX_WORKER_MEM=1g
NETBOX_WORKER_CPUS=1
NETBOX_WORKER_REPLICAS=3
NETBOX_PG_MEM=8g
NETBOX_PG_CPUS=4
NETBOX_PG_SHARED_BUFFERS=2GB
NETBOX_PG_EFFECTIVE_CACHE_SIZE=6GB
NETBOX_PG_WORK_MEM=16MB
NETBOX_PG_MAINT_WORK_MEM=512MB
NETBOX_PG_MAX_CONNECTIONS=200
NETBOX_REDIS_MEM=1g
NETBOX_REDIS_CACHE_MAXMEM=1gb
NETBOX_REDIS_CACHE_LIMIT=1536m

# ---- Activepieces (replaces n8n; own PostgreSQL + Redis) --------------------
AP_ENCRYPTION_KEY=                # generated (32 hex chars). LOSING IT MAKES STORED CONNECTIONS UNREADABLE - back it up
AP_JWT_SECRET=                    # generated
AP_API_KEY=
AP_POSTGRES_DATABASE=activepieces
AP_POSTGRES_USERNAME=activepieces
AP_POSTGRES_PASSWORD=             # generated
AP_REDIS_PASSWORD=                # generated
AP_EXECUTION_MODE=UNSANDBOXED     # TODO(Phindani): see README "Activepieces sandboxing"
AP_WORKER_CONCURRENCY=10
AP_WORKER_REPLICAS=3
AP_EXECUTION_DATA_RETENTION_DAYS=30
AP_APP_MEM=2g
AP_APP_CPUS=2
AP_WORKER_MEM=2g
AP_WORKER_CPUS=2
AP_PG_MEM=2g
AP_REDIS_MEM=1g

# ---- Netdisco (own PostgreSQL) ----------------------------------------------
NETDISCO_DB_NAME=netdisco
NETDISCO_DB_USER=netdisco
NETDISCO_DB_PASSWORD=             # generated
NETDISCO_PG_MEM=4g
NETDISCO_BACKEND_MEM=4g
NETDISCO_BACKEND_CPUS=4
NETDISCO_WEB_MEM=1g

# ---- InsightEngine backend database (own PostgreSQL) -------------------------
IE_DB_NAME=insightengine
IE_DB_USER=insightengine
IE_DB_PASSWORD=                   # generated
IE_PG_MEM=2g
# ie-config database on the same PostgreSQL server (own role). Init script runs on an empty volume only.
IE_CONFIG_DB_NAME=ie_config
IE_CONFIG_DB_USER=ie_config
IE_CONFIG_DB_PASSWORD=            # generated
# Optional Grafana analytics databases (created on first postgres init when set).
TELEGRAF_PG_PASSWORD=
AP_DATA_PASSWORD=

# ---- Logs (profile "logs") ---------------------------------------------------
LOKI_RETENTION_PERIOD=2160h       # 90 days ~ 3 months
LOKI_MEM=8g
LOKI_CPUS=4

# ---- Config backups (profile "backup") --------------------------------------
OXIDIZED_RETENTION_DAYS=90
OXIDIZED_PRUNE_EVERY_SECONDS=86400
OXIDIZED_INTERVAL=14400           # seconds between backups of each device (4h)
OXIDIZED_THREADS=60
OXIDIZED_RELOAD_INTERVAL=600
OXIDIZED_NETBOX_FILTER='status=active&tag=oxidized'  # NetBox device filter
OXIDIZED_MEM=4g
OXIDIZED_CPUS=4

# ---- Traps (profile "traps") -------------------------------------------------
TRAP_ALERT_TTL_SECONDS=3600
TRAPD_MEM=1g
TRAPD_CPUS=2

# ---- Custom exporter (profile "cust-exporter") ------------------------------
CUST_EXPORTER_MEM=512m

# ---- admin basic-auth plaintext (kept ONLY so you can read it; compose uses the hash) ----
ADMIN_BASIC_PASSWORD=             # generated

# --- first-run setup service / custom UI -------------------------------------
# Docker access for the setup service goes through a filtered docker-socket-proxy
# (ROOT-EQUIVALENT risk, see README "Security flags").
DOCKER_PROXY_IMAGE=tecnativa/docker-socket-proxy:v0.5.0    # TODO(Phindani): confirm tag
SETUP_OLD_STACK_ROOT=/opt        # read-only mount of the old stack's folders into the setup container
SETUP_PUBLIC_AFTER_COMPLETE=no   # yes = /setup/* stays reachable through Caddy after setup (default: only /setup/state)
SETUP_MEM=512m                   # ESTIMATE
# Empty builds insightengine-ui:local from ./ui/Dockerfile (Next.js, port 8080,
# NEXT_PUBLIC_IE_API_MODE=live). Set IE_UI_IMAGE to pull a different image instead.
IE_UI_IMAGE=
IE_UI_PORT=8080
IE_UI_DOCKERFILE=Dockerfile
