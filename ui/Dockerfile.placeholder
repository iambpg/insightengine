# Fallback only when ui/Dockerfile is absent. install.sh sets IE_UI_DOCKERFILE to
# this file in that case. The real UI is ui/Dockerfile (Next.js, port 8080).
FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY placeholder/index.html /usr/share/nginx/html/index.html
COPY placeholder/healthz /usr/share/nginx/html/healthz
EXPOSE 8080
