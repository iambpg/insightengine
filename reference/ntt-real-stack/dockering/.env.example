# ============================================
# NETWORK & HOST CONFIGURATION
# ============================================
# Set HOST_IP to the reachable IP of this server
HOST_IP=203.0.113.10

# Set HOST_USER, HOST_UID, HOST_GID to match the Ubuntu user on this server.
# deploy_monitoring_stack.py auto-detects these from the running user
# (e.g. monserver01, monserver02, etc.) - these are only fallback defaults.
HOST_USER={{DEPLOY_USER}}
HOST_UID=1000
HOST_GID=1000

# ============================================
# GRAFANA CONFIGURATION
# ============================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# ============================================
# NETBOX DATABASE CONFIGURATION - POSTGRESQL
# ============================================
NETBOX_DB_PASSWORD=CHANGE_ME
POSTGRES_DB_NAME=netbox
POSTGRES_USER=netbox

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_PASSWORD=CHANGE_ME

# ============================================
# NETBOX APPLICATION CONFIGURATION
# ============================================
# Must be at least 50 characters long and unique
NETBOX_SECRET_KEY=CHANGE_ME_MIN_50_CHARS
NETBOX_SUPERUSER_EMAIL=admin@yourdomain.com
NETBOX_SUPERUSER_NAME=netboxadmin
NETBOX_SUPERUSER_PASSWORD=CHANGE_ME

# ============================================
# ACTIVEPIECES CONFIGURATION
# ============================================
# 32 hex chars (256-bit) — auto-generated by deploy script
AP_ENCRYPTION_KEY=CHANGE_ME
# 64 hex chars — auto-generated by deploy script
AP_JWT_SECRET=CHANGE_ME
AP_POSTGRES_DATABASE=activepieces
AP_POSTGRES_USERNAME=activepieces
AP_POSTGRES_PASSWORD=CHANGE_ME
AP_REDIS_PASSWORD=CHANGE_ME

# ============================================
# ANALYTICAL DATA DATABASES (on shared-postgres)
# ============================================
# Activepieces workflow output → Grafana
AP_DATA_DB=activepieces_data
AP_DATA_USER=activepieces_data
AP_DATA_PASSWORD=CHANGE_ME
# Telegraf API data → Grafana
TELEGRAF_PG_DB=telegraf_data
TELEGRAF_PG_USER=telegraf
TELEGRAF_PG_PASSWORD=CHANGE_ME
FORTIGATE_API_TOKEN=CHANGE_ME

# ============================================
# SNMP CREDENTIAL CONFIGURATION
# ============================================
SNMP_V3_USERNAME=CHANGE_ME
SNMP_V3_AUTH_PASSWORD=CHANGE_ME
SNMP_V3_PRIV_PASSWORD=CHANGE_ME
SNMP_V2_COMMUNITY=CHANGE_ME
