# Global configuration
{
    # Enable automatic HTTPS with internal CA
    auto_https disable_redirects

    # Log settings
    log {
        level INFO
        output file /data/access.log {
            roll_size 100mb
            roll_keep 5
        }
    }

    # Admin API - secure to localhost only
    admin 0.0.0.0:2019
}

# Define common headers for all sites (security headers + HSTS)
(common_headers) {
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }
}

# Define TLS settings (self-signed cert with IP SAN)
(tls_cert) {
    tls /etc/caddy/certs/server.crt /etc/caddy/certs/server.key
}

# ============================================
# HTTP → HTTPS redirect (port 80)
# ============================================
:80 {
    redir https://{host}:9090{uri} 301
}

# ============================================
# Prometheus - Metrics and Alerting (HTTPS)
# ============================================
:9090 {
    import tls_cert
    import common_headers

    reverse_proxy prometheus-ntt:9090 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto https
    }

    # Basic authentication for Prometheus
    basicauth {
        admin REDACTED
    }

    # Request logging
    log {
        output file /data/prometheus_access.log {
            roll_size 50mb
            roll_keep 3
        }
    }
}

# ============================================
# Grafana - Visualization Dashboard (HTTPS)
# ============================================
:3000 {
    import tls_cert
    import common_headers

    reverse_proxy grafana-ntt:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto https
        transport http {
            dial_timeout 60s
            response_header_timeout 60s
        }
    }

    # Increase body size for large dashboards
    request_body {
        max_size 20MB
    }

    log {
        output file /data/grafana_access.log {
            roll_size 50mb
            roll_keep 3
        }
    }
}

