# secrets and per-client state - never commit
.env
.install-started
secrets/*
!secrets/.gitkeep
certs/*
!certs/.gitkeep
data/*
!data/migration/
data/migration/*
!data/migration/.gitkeep
migration/migrate.conf
migration/imported/
*.dump
*.key
*.pem

# Customer UI install and build output, and local env. ui/.env.example is committed.
ui/node_modules
ui/.next
ui/.env*
!ui/.env.example
